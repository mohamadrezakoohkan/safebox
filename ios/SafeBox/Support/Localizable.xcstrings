    "numpad_guide_page3_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any digits, any length from 4 to 32 — order matters. Try one here. This is just practice; nothing is saved."
