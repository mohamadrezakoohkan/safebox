        }
      }
    },
    "numpad_guide_page3_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your PIN is 4 to 32 digits"
          }
        }
      }
    },
    "numpad_guide_page4_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To unlock, enter your PIN and tap ✓. A wrong PIN shakes and clears — anyone can see it's a lock screen, but not what it protects."
          }
        }
      }
    },
    "numpad_guide_page4_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
