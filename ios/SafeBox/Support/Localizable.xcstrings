    },
    "calculator_guide_page3_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick 4 to 32 calculator keys — digits and symbols all count, and order matters. Try one here. This is just practice; nothing is saved."
          }
        }
      }
    },
    "calculator_guide_page3_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your code is a key sequence"
          }
        }
      }
    },
    "calculator_guide_page4_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To unlock, type your code on the calculator and press =. A wrong code just calculates — no error, no hint that anything is hidden."
          }
        }
      }
    },
    "calculator_guide_page4_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press = to enter"
