          }
        }
      }
    },
    "disguise_switch_explainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current code belongs to the %1$@ disguise and is confirmed with %2$@. The new disguise needs a new code, set on its own keys. Your photos, notes, and contacts are unchanged."
          }
        }
      }
    },
    "disguise_switch_success_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your new code works from now on. There is no way to recover it — if you forget it, your vault contents cannot be retrieved."
          }
        }
      }
    },
