<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The ONE permission the app declares (decisions §13). It exists solely for
      the manual "Check for updates" row in Settings → About: a single bare GET
      to the repo's version.json, made only when the user taps that row.
      Accepted tell: INTERNET is visible in the OS app-info screen for what
      presents itself as a calculator.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Media3 (N3) merges two <uses-permission> declarations of its own, for
      network playback and for keeping the screen/CPU awake during background
      playback. SafeBox plays only local vault files and never plays in the
      background, so both are removed:
        * ACCESS_NETWORK_STATE — the update check needs INTERNET and nothing
          more; reading the network state would be a second, pointless tell
          (`DefaultBandwidthMeter` /
          `NetworkTypeObserver` catch the resulting SecurityException and report
          "unknown network", which is the correct answer for a local file).
        * WAKE_LOCK — only ever acquired for a wake mode other than
          C.WAKE_MODE_NONE, and VaultVideoPage sets WAKE_MODE_NONE explicitly.
      There is deliberately NO android:supportsPictureInPicture anywhere: PiP
      would render vault video in a floating window outside the app.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />

    <application
        android:name=".SafeBoxApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.CalcPlus"
        android:supportsRtl="true">

        <!--
          The activity itself is NO LONGER a launcher entry (decisions §9a).
          The home-screen icon and name follow the enrolled lock face, and an
          activity cannot change its own icon at runtime — an activity-alias
          can be enabled or disabled. So the three cover identities below are
          the launcher entries, all targeting this one activity.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CalcPlus" />

        <!--
          Cover identities (decisions §9a). EXACTLY ONE is enabled at a time;
          AppIconManager enables the incoming one BEFORE disabling the others,
          so the app can never vanish from the launcher, and passes
          DONT_KILL_APP so the process survives the swap.

          Calculator+ is the shipped default, so it is the only alias enabled
          in the manifest — a fresh install, and any install whose component
          settings were reset, lands on the calculator identity.

          Accepted tells, disclosed in-app via disguise_identity_disclosure:
          the app-info screen still reads "Calculator+" (that label comes from
          the <application> element, which cannot change), and some launchers
          move a renamed icon out of its home-screen position.
        -->
        <activity-alias
            android:name=".CalculatorAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/cover_name_calculator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".NotepadAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_notepad"
            android:label="@string/cover_name_notepad">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".GalleryAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_gallery"
            android:label="@string/cover_name_gallery">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
