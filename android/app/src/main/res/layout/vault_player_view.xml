<?xml version="1.0" encoding="utf-8"?>
<!--
  The vault's ONLY video surface (iteration-2-decisions §9).

  `surface_type="texture_view"` is disguise-critical and must never change to
  surface_view: a SurfaceView punches a hole through the window and is composited
  by SurfaceFlinger, which FLAG_SECURE on the window does not reliably cover, so
  vault video could show up in a screen recording or a recents thumbnail. A
  TextureView draws inside the window's own hierarchy, so MainActivity's
  unconditional FLAG_SECURE covers it.

  The controller is enabled (play/pause/scrub) but has no fullscreen button, so
  nothing here can hand the video to another window.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vault_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    app:surface_type="texture_view"
    app:use_controller="true"
    app:hide_on_touch="true"
    app:show_buffering="when_playing"
    app:resize_mode="fit" />
